<Window x:Class="MinecraftServerLauncher.WindowClosingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinecraftServerLauncher"
        mc:Ignorable="d" Style="{StaticResource LauncherDialogStyle}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Title="Closing..." Height="170" Width="320">
    <Grid>
        <Border Padding="7" Grid.Row="1" Margin="5" Background="{StaticResource Launcher.Window.GrayBrush4}" BorderThickness="4" CornerRadius="20" BorderBrush="{StaticResource Launcher.Window.GrayBrush6}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="Closing..." HorizontalAlignment="Center" FontSize="35"/>
                <TextBlock Grid.Row="1" Text="Please wait, this can take up to 10 seconds." TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="14"/>
                <ProgressBar Grid.Row="2" IsIndeterminate="True" Margin="0,0,0,5"/>
            </Grid>
        </Border>
    </Grid>
</Window>
