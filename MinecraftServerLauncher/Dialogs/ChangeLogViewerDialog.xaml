<Window x:Class="MinecraftServerLauncher.ChangeLogViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinecraftServerLauncher"
        mc:Ignorable="d" Style="{StaticResource LauncherDialogStyle}" WindowStartupLocation="CenterOwner"
        Title="Change Log Viewer" MinHeight="400" MinWidth="600" Height="620" Width="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="35"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Launcher.Window.GrayBrush4}" BorderBrush="{StaticResource Launcher.Window.GrayBrush5}" BorderThickness="2" CornerRadius="5" Padding="1,1" Margin="2,2,2,2">
            <Border x:Name="rarityBorder" Grid.Row="0" CornerRadius="4" BorderThickness="2" BorderBrush="{StaticResource Launcher.Rarity.UndefinedGradient}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid MinHeight="50">
                        <TextBlock x:Name="updateType" Text="(UpdateType)" Margin="5,0,10,5" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock x:Name="changelogTitle" Text="Version (VersionNumbers)" Margin="5,7,5,2" FontSize="25" VerticalAlignment="Bottom"/>
                    </Grid>
                    <Image x:Name="importantUpdateSymbol" ToolTip="Reason" ToolTipService.InitialShowDelay="0" Width="40" Height="40" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" Source="/Dictionaries/AlertIcon.png"/>
                </Grid>
            </Border>
        </Border>
        <TextBlock Text="Change List" Margin="10,0,0,0" Grid.Row="1" FontSize="21" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
        <Border Grid.Row="2" Background="{StaticResource Launcher.Window.GrayBrush2}" BorderBrush="{StaticResource Launcher.Window.GrayBrush4}" BorderThickness="2" Padding="4" Margin="5" CornerRadius="5">
            <ScrollViewer VerticalAlignment="Stretch">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Additions:" FontSize="20" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                    <RichTextBox x:Name="additionList" IsReadOnly="True" FontSize="16" Style="{StaticResource roundedRTB}"/>

                    <Rectangle Height="2" Margin="5,7,5,7" Fill="{StaticResource Launcher.Window.GrayBrush6}"/>

                    <TextBlock Text="Changes:" FontSize="20" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                    <RichTextBox x:Name="changeList" IsReadOnly="True" FontSize="16" Style="{StaticResource roundedRTB}"/>

                    <Rectangle Height="2" Margin="5,7,5,7" Fill="{StaticResource Launcher.Window.GrayBrush6}"/>

                    <TextBlock Text="Bug Fixes:" FontSize="20" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                    <RichTextBox x:Name="bugfixList" IsReadOnly="True" FontSize="16" Style="{StaticResource roundedRTB}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Button Grid.Row="3" Content="Back" Width="140" Margin="40,0" HorizontalAlignment="Center" FontSize="20" Style="{StaticResource NormalButton}" Click="Back_Button_Clicked"/>
    </Grid>
</Window>
