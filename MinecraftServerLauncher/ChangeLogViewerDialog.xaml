<Window x:Class="MinecraftServerLauncher.ChangeLogViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinecraftServerLauncher"
        mc:Ignorable="d" Style="{StaticResource LauncherDialogStyle}" WindowStartupLocation="CenterOwner"
        Title="Changelog Viewer" MinHeight="480" MinWidth="400" Height="480" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="35"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="changelogTitle" Text="(Changelog name)" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Change Log" Grid.Row="1" FontSize="20" VerticalAlignment="Top" HorizontalAlignment="Center"/>
        <RichTextBox x:Name="changeList" IsReadOnly="True" FontSize="15" Grid.Row="2" Margin="7" Style="{StaticResource roundedRTB}"/>
        <Button Grid.Row="3" Content="Back" Width="140" Margin="40,0" HorizontalAlignment="Center" FontSize="20" Style="{StaticResource NormalButton}" Click="Back_Button_Clicked"/>
    </Grid>
</Window>
