<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Launcher.Window.GrayColor1">#101015</Color>
    <Color x:Key="Launcher.Window.GrayColor2">#1D1E26</Color>
    <Color x:Key="Launcher.Window.GrayColor3">#20212A</Color>
    <Color x:Key="Launcher.Window.GrayColor4">#33333F</Color>
    <Color x:Key="Launcher.Window.GrayColor4r">#564949</Color>
    <Color x:Key="Launcher.Window.GrayColor5">#3D3D4C</Color>
    <Color x:Key="Launcher.Window.GrayColor5r">#70323E</Color>
    <Color x:Key="Launcher.Window.GrayColor6">#4A4A5B</Color>

    <Color x:Key="Launcher.Disabled.FontColor">#AFAFAF</Color>
    <Color x:Key="Launcher.FontColor">#F2F2F2</Color>
    <Color x:Key="Launcher.Selected.BackgroundColor">#9E0700</Color>

    <Color x:Key="Launcher.RedColor">#D7263D</Color>
    <Color x:Key="Launcher.YellowColor">#FF9F1C</Color>
    <Color x:Key="Launcher.GreenColor">#05AD00</Color>
    <Color x:Key="Launcher.BlueColor">#0055FF</Color>

    <SolidColorBrush Color="{StaticResource Launcher.Window.GrayColor1}" x:Key="Launcher.Window.GrayBrush1"/>
    <SolidColorBrush Color="{StaticResource Launcher.Window.GrayColor2}" x:Key="Launcher.Window.GrayBrush2"/>
    <SolidColorBrush Color="{StaticResource Launcher.Window.GrayColor3}" x:Key="Launcher.Window.GrayBrush3"/>
    <SolidColorBrush Color="{StaticResource Launcher.Window.GrayColor4}" x:Key="Launcher.Window.GrayBrush4"/>
    <SolidColorBrush Color="{StaticResource Launcher.Window.GrayColor4r}" x:Key="Launcher.Window.GrayBrush4r"/>
    <SolidColorBrush Color="{StaticResource Launcher.Window.GrayColor5}" x:Key="Launcher.Window.GrayBrush5"/>
    <SolidColorBrush Color="{StaticResource Launcher.Window.GrayColor5r}" x:Key="Launcher.Window.GrayBrush5r"/>
    <SolidColorBrush Color="{StaticResource Launcher.Window.GrayColor6}" x:Key="Launcher.Window.GrayBrush6"/>

    <SolidColorBrush Color="{StaticResource Launcher.Disabled.FontColor}" x:Key="Launcher.Disabled.FontBrush"/>
    <SolidColorBrush Color="{StaticResource Launcher.FontColor}" x:Key="Launcher.FontBrush"/>
    <SolidColorBrush Color="{StaticResource Launcher.Selected.BackgroundColor}" x:Key="Launcher.Selected.BackgroundBrush"/>

    <SolidColorBrush Color="{StaticResource Launcher.RedColor}" x:Key="Launcher.RedBrush"/>
    <SolidColorBrush Color="{StaticResource Launcher.YellowColor}" x:Key="Launcher.YellowBrush"/>
    <SolidColorBrush Color="{StaticResource Launcher.GreenColor}" x:Key="Launcher.GreenBrush"/>
    <SolidColorBrush Color="{StaticResource Launcher.BlueColor}" x:Key="Launcher.BlueBrush"/>
</ResourceDictionary>